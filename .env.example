# Copied and filled in per sekolah by the provisioning script.
# One instance = one file like this, sitting next to its cbt-server binary.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sekolah_cbt
# schema is per-sekolah, e.g. cbt_smpn1turen
DB_SCHEMA=cbt_contoh_sekolah

# picked at provisioning time from the free range 13000-14000
# (Extraordinary CBT already uses 12000-13000, so this avoids collisions)
PORT=13000

# shared with the Laravel app so it can issue admin JWTs this server trusts
JWT_SECRET=

# used only in /health and logs, matches the sekolah's id in sekolah.co.id
SEKOLAH_ID=
